<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <OutputType>WinExe</OutputType>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>MakinoMCP</AssemblyName>
    <!-- SignPath signs only files whose product name is MakinoMCP (.signpath/artifact-configuration.xml). -->
    <Product>MakinoMCP</Product>
    <Version>0.8.1</Version>
    <RootNamespace>MakinoMCP</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <!-- The setup window shows the updates section only where the launcher would update from GitHub. -->
    <Compile Include="..\MakinoMCP.Launcher\UpdateSource.cs" Link="Setup\UpdateSource.cs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="ModelContextProtocol" Version="2.3.0" />
    <PackageReference Include="System.Management" Version="10.0.14" />
    <ProjectReference Include="..\MakinoMCP.Core\MakinoMCP.Core.csproj" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.14" />
  </ItemGroup>
</Project>
